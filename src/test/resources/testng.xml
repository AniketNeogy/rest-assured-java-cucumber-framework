<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PetStore API Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.petstore.api.listeners.TestListener" />
    </listeners>
    
    <test name="Pet API Tests">
        <packages>
            <package name="com.petstore.api.tests.pet" />
        </packages>
    </test>
    
    <test name="Store API Tests">
        <packages>
            <package name="com.petstore.api.tests.store" />
        </packages>
    </test>
    
    <test name="User API Tests">
        <packages>
            <package name="com.petstore.api.tests.user" />
        </packages>
    </test>
</suite> 